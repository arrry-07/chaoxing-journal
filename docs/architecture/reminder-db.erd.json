  "cards": [
    {
      "dot": "cyan",
      "title": "SQLite v10 与有声渠道迁移",
      "items": [
        "库文件 assignment_reminders_v1.db 当前 DATABASE_VERSION = 10，含 7 张物理表与 107 个真实列",
        "v8 引入 allow_urgent_night_breakthrough、deadline_channel_id 与快照/事件 deadline_source",
        "v9→v10 将旧版 deadline_channel_id 自动迁移至 assignment_deadlines_v3，保留既有渠道独立性"
      ]
    },
    {
      "dot": "emerald",
      "title": "事务级账号代次隔离与防脏写",
      "items": [
        "SQLite 建表未启用外键级联，而是通过 @Synchronized transaction 按 (account_hash, session_epoch) 清理隔离",
        "accounts 的 pending_update、mutation_version 与 claim_token 串联两阶段提醒计划提交与并发互斥",
        "notification_attempts 备份 prior_* 版本以便后台信号检查取消或失败时完整回滚"
      ]
    },
    {
      "dot": "amber",
      "title": "复合主键与查询索引约束",
      "items": [
        "snapshots 主键为 (account_hash, assignment_id)；reminder_schedule_evidence 主键为 (account_hash, history_generation, logical_key)",
        "notification_signals 对 (account_hash, signal_key, received_at) 建唯一约束，reminder_history 对 (account_hash, history_generation, observation_id) 建唯一索引",
        "V7 起补齐 events_notification_id、events_account_assignment、notification_signals_received_at 与 reminder_schedule_evidence_subject 索引"
      ]
    }
  ]
}
