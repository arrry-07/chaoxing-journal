  "flows": [
    {
      "id": "raw_coursework",
      "from": "chaoxing_api",
      "to": "parsers_merge",
      "label": "原始课业响应",
      "variant": "emphasis"
    },
    {
      "id": "signals_edits",
      "from": "signal_and_manual",
      "to": "session_lease_gate",
      "label": "通知信号与编辑",
      "variant": "security"
    },
    {
      "id": "lease_permit",
      "from": "session_lease_gate",
      "to": "parsers_merge",
      "label": "代次与租约放行",
      "variant": "security"
    },
    {
      "id": "normalized_items",
      "from": "parsers_merge",
      "to": "time_trust_query",
      "label": "归一化课业集",
      "variant": "emphasis"
    },
    {
      "id": "trusted_deadlines",
      "from": "time_trust_query",
      "to": "reminder_planner",
      "label": "可信截止时间",
      "variant": "default"
    },
    {
      "id": "merged_snapshot",
      "from": "time_trust_query",
      "to": "prefs_snapshot",
      "label": "合并课业快照",
      "variant": "emphasis"
    },
    {
      "id": "plan_snapshot",
      "from": "reminder_planner",
      "to": "sqlite_reminder_db",
      "label": "提醒计划快照",
      "variant": "security"
    },
    {
      "id": "version_commit",
      "from": "prefs_snapshot",
      "to": "sqlite_reminder_db",
      "label": "版本号提交确认",
      "variant": "dashed"
    },
    {
      "id": "ui_widget_feed",
      "from": "prefs_snapshot",
      "to": "home_and_widget",
      "label": "已校验展示快照",
      "variant": "emphasis"
    },
    {
      "id": "due_events",
      "from": "sqlite_reminder_db",
      "to": "native_alarm_pub",
      "label": "到期事件与复核",
      "variant": "default"
    }
  ],
  "cards": [
    {
      "dot": "emerald",
      "title": "时间信任隔离契约",
      "items": ["考试展示范围文案绝不写回可信截止时间、日历、提醒或备份", "官方可信截止一旦出现即自动接管，防止旧手动截止时间复活", "读取失败与未知时间独立保留，严禁折叠为无截止或零作业"]
    },
    {
      "dot": "rose",
      "title": "两阶段版本化提醒提交",
      "items": ["写盘前先在 SQLite 标记 pendingUpdate，再写入 SharedPreferences", "随后凭读取时的 mutationVersion 与 sessionEpoch 提交提醒计划", "版本或账号代次失配立即拒绝并重排，杜绝前后台引擎互相覆盖"]
    },
    {
      "dot": "amber",
      "title": "原生投递前二次校验",
      "items": ["闹钟唤醒后在原生侧复核完成、隐藏、关注、归档与夜间静音窗", "夜间 [23:30, 07:30) 默认静音顺延，支持按账号开启 <=1h 紧急穿透", "个人日程与每日摘要走独立补偿式通知事务，不与作业闹钟混清"]
    }
  ]
