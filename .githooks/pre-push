#!/usr/bin/env sh
set -eu

repo_root=$(git rev-parse --show-toplevel)
if command -v python3 >/dev/null 2>&1; then
  py=python3
elif command -v python >/dev/null 2>&1; then
  py=python
else
  echo "[FAIL] Python is required for .githooks/pre-push" >&2
  exit 1
fi

zero_oid="0000000000000000000000000000000000000000"
while read -r _local_ref local_sha _remote_ref remote_sha; do
  local_sha=$(printf '%s' "${local_sha:-}" | tr -d '\r')
  remote_sha=$(printf '%s' "${remote_sha:-}" | tr -d '\r')
  [ -n "$local_sha" ] || continue
  [ "$local_sha" != "$zero_oid" ] || continue
  commit_sha=$(git rev-parse "${local_sha}^{commit}" 2>/dev/null || printf '%s' "$local_sha")
  if [ "$remote_sha" != "$zero_oid" ]; then
    "$py" "$repo_root/scripts/check_repo_safety.py" --range "${remote_sha}..${commit_sha}"
  else
    "$py" "$repo_root/scripts/check_repo_safety.py" --unpushed "$commit_sha"
  fi
done
